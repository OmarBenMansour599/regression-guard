# Copy to .env (repo root) and fill in. Never commit .env.
# Model choice is NOT configured here: it lives in the versioned prompt files.

# openai_compatible (OpenRouter, Groq, ...) or mock (offline, no key needed)
REGGUARD_LLM_PROVIDER=openai_compatible
REGGUARD_LLM_API_KEY=
REGGUARD_LLM_BASE_URL=https://openrouter.ai/api/v1
# Optional local override of the prompt's model, for experiments only
REGGUARD_LLM_MODEL=

# Execution policy (free tiers: keep concurrency low)
REGGUARD_MAX_CONCURRENCY=3
REGGUARD_REQUEST_TIMEOUT_S=60
REGGUARD_MAX_RETRIES=4

# Optional integrations
REGGUARD_SLACK_WEBHOOK_URL=
REGGUARD_DATABASE_URL=sqlite+aiosqlite:///./.regguard/regguard.db

# Logging: DEBUG|INFO|WARNING|ERROR and console|json
REGGUARD_LOG_LEVEL=INFO
REGGUARD_LOG_FORMAT=console
