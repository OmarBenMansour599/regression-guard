<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ verdict | upper }} · {{ meta.app }} · {{ meta.prompt_version }} · RegressionGuard</title>
<style>
  :root {
    --bg: #ffffff; --fg: #1f2328; --muted: #59636e; --border: #d1d9e0; --panel: #f6f8fa;
    --pass: #1a7f37; --warn: #9a6700; --fail: #cf222e; --error: #8250df;
    --pass-bg: #dafbe1; --warn-bg: #fff8c5; --fail-bg: #ffebe9; --error-bg: #fbefff;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1117; --fg: #e6edf3; --muted: #9198a1; --border: #3d444d; --panel: #151b23;
      --pass: #3fb950; --warn: #d29922; --fail: #f85149; --error: #ab7df8;
      --pass-bg: #0f2d1a; --warn-bg: #2e2309; --fail-bg: #3a1214; --error-bg: #2a1a42;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 64px; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  h2 { font-size: 18px; margin: 32px 0 8px; padding-bottom: 4px; border-bottom: 1px solid var(--border); }
  .muted { color: var(--muted); }
  code, pre { font: 13px/1.45 ui-monospace, SFMono-Regular, Consolas, monospace; }
  pre { white-space: pre-wrap; word-break: break-word; margin: 0; padding: 8px;
        background: var(--panel); border: 1px solid var(--border); border-radius: 6px; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-weight: 600;
           font-size: 13px; text-transform: uppercase; letter-spacing: .03em; }
  .pass { color: var(--pass); background: var(--pass-bg); }
  .warn { color: var(--warn); background: var(--warn-bg); }
  .fail { color: var(--fail); background: var(--fail-bg); }
  .error { color: var(--error); background: var(--error-bg); }
  .critical { color: var(--fail); font-weight: 600; }
  .hero { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; margin: 16px 0;
          padding: 16px; border: 1px solid var(--border); border-radius: 8px; background: var(--panel); }
  .hero .badge { font-size: 20px; padding: 6px 18px; }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 4px 24px; }
  .meta div { overflow-wrap: anywhere; }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 14px; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  ul.reasons { padding-left: 0; list-style: none; }
  ul.reasons li { margin: 6px 0; }
  .case { border: 1px solid var(--border); border-radius: 8px; padding: 12px; margin: 12px 0; }
  .case h3 { font-size: 15px; margin: 0 0 8px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; }
  .label { font-size: 12px; color: var(--muted); margin: 8px 0 2px; text-transform: uppercase; letter-spacing: .04em; }
  .spark { color: var(--muted); vertical-align: middle; }
  details summary { cursor: pointer; font-weight: 600; margin: 8px 0; }
  footer { margin-top: 48px; color: var(--muted); font-size: 13px; }
</style>
</head>
<body>
<main>
  <h1>RegressionGuard report</h1>
  <div class="muted">{{ meta.app }} · run <code>{{ meta.run_id }}</code> · generated {{ generated_at }}</div>

  <div class="hero">
    <span class="badge {{ verdict_class }}">{{ verdict }}</span>
    <div>
      {% if comparison %}
        Prompt <strong>{{ meta.prompt_version }}</strong> compared with
        {% if comparison.baseline_name %}baseline <strong>{{ comparison.baseline_name }}</strong>{% else %}run{% endif %}
        <code>{{ comparison.baseline_run_id }}</code>{% if baseline %} (prompt {{ baseline.meta.prompt_version }}){% endif %}.
        {% if counts %}<br><span class="muted">
          {% for key, n in counts | dictsort %}{{ n }} {{ key | replace("_", " ") }}{% if not loop.last %} · {% endif %}{% endfor %}
        </span>{% endif %}
      {% else %}
        Single run, no baseline comparison.
      {% endif %}
      {% if run.error %}<br><span class="critical">Run error: {{ run.error }}</span>{% endif %}
    </div>
  </div>

  <div class="meta">
    <div><span class="muted">Prompt</span> {{ meta.prompt_version }} <code>{{ meta.prompt_hash[7:19] }}</code></div>
    <div><span class="muted">Model</span> {{ meta.model }}{% if meta.model_override %} (override){% endif %}</div>
    <div><span class="muted">Dataset</span> {{ meta.dataset_version }} <code>{{ meta.dataset_hash[7:19] }}</code></div>
    <div><span class="muted">Cases</span> {{ views | length }} × {{ meta.n_samples }} sample(s)</div>
    <div><span class="muted">Judge</span> {% if meta.judge %}{{ meta.judge.prompt_version }} · {{ meta.judge.model }}{% else %}none{% endif %}</div>
    <div><span class="muted">Calls</span> {{ meta.execution.api_calls }} API, {{ meta.execution.cache_hits }} cached, {{ meta.execution.retries }} retries</div>
    <div><span class="muted">Git</span> <code>{{ meta.git_sha or "–" }}</code></div>
    <div><span class="muted">Started</span> {{ meta.started_at.strftime("%Y-%m-%d %H:%M UTC") }}</div>
  </div>

  {% if comparison %}
  <h2>Why this verdict</h2>
  <ul class="reasons">
    {% for r in reasons %}
    <li><span class="badge {{ r.severity.value }}">{{ r.severity.value }}</span> <code>{{ r.code }}</code> {{ r.message }}</li>
    {% else %}
    <li class="muted">No metric crossed a threshold.</li>
    {% endfor %}
  </ul>

  <h2>Metrics</h2>
  <div class="table-wrap"><table>
    <thead><tr><th>Metric</th><th class="num">Baseline</th><th class="num">Candidate</th><th class="num">Change</th>
      <th class="num">−/+</th><th class="num">p</th><th>Level</th><th>Trend</th></tr></thead>
    <tbody>
    {% for m in metrics %}
      <tr>
        <td><code>{{ m.name }}</code>{% if not m.gating %} <span class="muted">(info)</span>{% endif %}</td>
        <td class="num">{{ m.baseline }}</td><td class="num">{{ m.candidate }}</td><td class="num">{{ m.delta }}</td>
        <td class="num">{{ m.flips }}</td><td class="num">{{ m.p }}</td>
        <td>{% if m.level %}<span class="badge {{ 'fail' if m.level == 'critical' else 'warn' }}">{{ m.level }}</span>{% endif %}</td>
        <td>{{ m.trend }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% else %}
  <h2>Scores</h2>
  <div class="table-wrap"><table>
    <thead><tr><th>Metric</th><th class="num">Value</th><th class="num">n</th><th>Trend</th></tr></thead>
    <tbody>
    {% for name, value, n in aggregates %}
      <tr><td><code>{{ name }}</code></td><td class="num">{{ value }}</td><td class="num">{{ n }}</td>
        <td>{{ trends.get(name, "") }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% endif %}

  {% if changed %}
  <h2>Changed cases</h2>
  {% for v in changed %}
  <div class="case">
    <h3><code>{{ v.case_id }}</code>
      <span class="badge {{ 'fail' if v.change == 'regressed' else 'pass' }}">{{ v.change }}</span>
      {% if v.label %}<span class="muted">{{ v.label }}</span>{% endif %}
      {% if v.critical %}<span class="critical">critical case</span>{% endif %}
      {% if v.failed_metrics %}<span class="muted">now failing: {{ v.failed_metrics | join(", ") }}</span>{% endif %}
    </h3>
    {% if v.input_text %}<div class="label">Input</div><pre>{{ v.input_text }}</pre>{% endif %}
    {% if v.expected %}<div class="label">Expected (golden label)</div><pre>{{ v.expected }}</pre>{% endif %}
    <div class="grid2">
      <div><div class="label">Baseline output</div><pre>{{ v.baseline_output or "–" }}</pre>
        {% if v.baseline_judge %}<div class="muted">Judge: {{ v.baseline_judge }}</div>{% endif %}</div>
      <div><div class="label">Candidate output</div><pre>{{ v.candidate_output or "–" }}</pre>
        {% if v.judge %}<div class="muted">Judge: {{ v.judge }}</div>{% endif %}</div>
    </div>
  </div>
  {% endfor %}
  {% endif %}

  {% if problems %}
  <h2>Other failing or errored cases</h2>
  {% for v in problems %}
  <div class="case">
    <h3><code>{{ v.case_id }}</code>
      <span class="badge {{ 'error' if v.passed is none else 'fail' }}">{{ 'error' if v.passed is none else 'fail' }}</span>
      {% if v.label %}<span class="muted">{{ v.label }}</span>{% endif %}
      {% if v.change %}<span class="muted">{{ v.change | replace("_", " ") }}</span>{% endif %}
    </h3>
    {% if v.input_text %}<div class="label">Input</div><pre>{{ v.input_text }}</pre>{% endif %}
    {% if v.expected %}<div class="label">Expected</div><pre>{{ v.expected }}</pre>{% endif %}
    <div class="label">Output</div><pre>{{ v.candidate_output or "–" }}</pre>
  </div>
  {% endfor %}
  {% endif %}

  <h2>All cases</h2>
  <details>
    <summary>{{ views | length }} cases</summary>
    <div class="table-wrap"><table>
      <thead><tr><th>Case</th><th>Category</th><th>Result</th>{% if comparison %}<th>Change</th>{% endif %}<th>Judge</th></tr></thead>
      <tbody>
      {% for v in views %}
        <tr><td><code>{{ v.case_id }}</code>{% if v.critical %} <span class="critical">●</span>{% endif %}</td>
          <td>{{ v.label or "–" }}</td>
          <td><span class="badge {{ 'error' if v.passed is none else ('pass' if v.passed else 'fail') }}">{{ 'error' if v.passed is none else ('pass' if v.passed else 'fail') }}</span></td>
          {% if comparison %}<td>{{ (v.change or "–") | replace("_", " ") }}</td>{% endif %}
          <td>{{ v.judge or "–" }}</td></tr>
      {% endfor %}
      </tbody>
    </table></div>
  </details>

  {% if info or notes %}
  <h2>Notes</h2>
  <ul>
    {% for r in info %}<li><code>{{ r.code }}</code> {{ r.message }}</li>{% endfor %}
    {% for n in notes %}<li>{{ n }}</li>{% endfor %}
  </ul>
  {% endif %}

  <footer>RegressionGuard {{ version }} · inputs and outputs are shown as plain text (escaped).</footer>
</main>
</body>
</html>
