    "react-dom": "19.3.1",
    "react-router": "8.5.3",
    "recharts": "3.11.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
